<Window x:Class="Triptico.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Triptico.Views"
        Title="Tríptico"
        Icon="/Assets/triptico.ico"
        Width="800" Height="880" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24">

            <!-- Cabeçalho -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource Muted}" FontSize="12">
                    by <Run FontWeight="SemiBold" Text="zimutek" />
                </TextBlock>
                <Image Source="/Assets/triptico.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tríptico" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Os seus ecrãs, como quer, num clique." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <!-- Perfis -->
            <DockPanel Margin="0,28,0,12">
                <Button DockPanel.Dock="Right" Click="NewFromCurrent_Click"
                        Style="{DynamicResource AccentButtonStyle}" Padding="14,6">
                    <TextBlock><Run Text="＋" FontWeight="Bold" /> Guardar disposição atual</TextBlock>
                </Button>
                <TextBlock Text="Perfis" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Ainda não há perfis" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14">
                        Um perfil guarda que ecrãs ficam ligados e onde fica cada um, para trocar com um atalho.
                        Crie os sugeridos (todos os ecrãs + um só com cada ecrã) ou arrume os ecrãs
                        no Windows como gosta e clique em «Guardar disposição atual».
                        Para ligar ou desligar um ecrã já, use os botões na lista em baixo.
                    </TextBlock>
                    <Button Content="Criar perfis sugeridos" Click="Suggested_Click" HorizontalAlignment="Left"
                            Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ProfilesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:ProfileCard}">
                        <Border x:Name="CardBorder" Style="{StaticResource Card}" Width="228" Margin="0,0,12,12" Padding="14,14,14,12">
                            <StackPanel>
                                <Border Height="76" CornerRadius="6" Padding="8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <v:LayoutPreview Items="{Binding Preview}" />
                                        <TextBlock Text="Sem disposição guardada" Style="{StaticResource Muted}" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding NoPreviewVisibility}" />
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,10,0,0">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding CurrentVisibility}">
                                        <TextBlock Text="ativo" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding HotkeyText}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{Binding HotkeyBrush}" TextTrimming="CharacterEllipsis" />

                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                    <Button Content="Aplicar" Click="Apply_Click" Tag="{Binding}" Padding="16,5"
                                            IsEnabled="{Binding CanApply}"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <Button DockPanel.Dock="Right" Content="⋯" Click="More_Click" Tag="{Binding}" Padding="10,5" ToolTip="Mais opções">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Atualizar com a disposição atual" Click="Recapture_Click" />
                                                <MenuItem Header="Duplicar" Click="Duplicate_Click" />
                                                <MenuItem Header="Mover para a esquerda" Click="MoveLeft_Click" />
                                                <MenuItem Header="Mover para a direita" Click="MoveRight_Click" />
                                                <Separator />
                                                <MenuItem Header="Apagar" Click="Delete_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Content="Editar" Click="Edit_Click" Tag="{Binding}" Padding="12,5" Margin="0,0,6,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ecrãs -->
            <DockPanel Margin="0,20,0,12">
                <Button DockPanel.Dock="Right" Content="Identificar ecrãs" Click="Identify_Click" Padding="14,6" />
                <Button x:Name="EnableAllButton" DockPanel.Dock="Right" Content="Ligar todos" Click="EnableAll_Click"
                        Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock Text="Ecrãs ligados ao PC" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <ItemsControl x:Name="MonitorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:MonitorRow}">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                            <DockPanel>
                                <Border x:Name="Badge" Width="30" Height="30" CornerRadius="15" Margin="0,0,14,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock x:Name="BadgeText" Text="{Binding Number}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right" Content="Mudar nome" Click="Rename_Click" Tag="{Binding}"
                                        Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Ligar" Click="TurnOn_Click" Tag="{Binding}"
                                        Padding="14,4" MinWidth="84" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding OffVisibility}" IsEnabled="{Binding CanToggle}"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button DockPanel.Dock="Right" Content="Desligar" Click="TurnOff_Click" Tag="{Binding}"
                                        Padding="14,4" MinWidth="84" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding OnVisibility}" IsEnabled="{Binding CanTurnOff}"
                                        ToolTip="Desliga este ecrã no Windows; os outros ficam como estão." />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" VerticalAlignment="Center"
                                           Style="{StaticResource Muted}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Opções -->
            <WrapPanel Margin="0,18,0,0">
                <CheckBox x:Name="StartupCheck" Content="Iniciar com o Windows" Margin="0,0,28,0"
                          Checked="Startup_Changed" Unchecked="Startup_Changed" />
                <CheckBox x:Name="NotifyCheck" Content="Avisar quando troco de perfil"
                          Checked="Notify_Changed" Unchecked="Notify_Changed" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0">
                Se um ecrã ficar sem imagem, use «Ligar todos os ecrãs» no ícone da bandeja
                (ou <Run FontWeight="SemiBold" Text="Win + P" /> → «Expandir»).
                Fechar esta janela deixa o Tríptico na bandeja, ao pé do relógio.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
