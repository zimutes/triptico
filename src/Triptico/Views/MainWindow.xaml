<Window x:Class="Triptico.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Triptico.Views"
        Title="Tríptico"
        Icon="/Assets/triptico.ico"
        Width="800" Height="880" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24">

            <!-- Cabeçalho -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                           Style="{StaticResource Muted}" FontSize="12">
                    by <Run FontWeight="SemiBold" Text="zimutek" />
                </TextBlock>
                <Image Source="/Assets/triptico.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tríptico" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Tagline}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <!-- Perfis -->
            <DockPanel Margin="0,28,0,12">
                <Button DockPanel.Dock="Right" Click="NewFromCurrent_Click"
                        Style="{DynamicResource AccentButtonStyle}" Padding="14,6">
                    <TextBlock><Run Text="＋" FontWeight="Bold" /> <Run Text="{DynamicResource L.SaveCurrent}" /></TextBlock>
                </Button>
                <TextBlock Text="{DynamicResource L.Profiles}" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.NoProfilesTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.NoProfilesText}" Style="{StaticResource Muted}" Margin="0,6,0,14" />
                    <Button Content="{DynamicResource L.CreateSuggested}" Click="Suggested_Click" HorizontalAlignment="Left"
                            Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ProfilesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:ProfileCard}">
                        <Border x:Name="CardBorder" Style="{StaticResource Card}" Width="228" Margin="0,0,12,12" Padding="14,14,14,12">
                            <StackPanel>
                                <Border Height="76" CornerRadius="6" Padding="8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <v:LayoutPreview Items="{Binding Preview}" />
                                        <TextBlock Text="{DynamicResource L.NoLayout}" Style="{StaticResource Muted}" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding NoPreviewVisibility}" />
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,10,0,0">
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding CurrentVisibility}">
                                        <TextBlock Text="{DynamicResource L.ActiveBadge}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding HotkeyText}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{Binding HotkeyBrush}" TextTrimming="CharacterEllipsis" />

                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                    <Button Content="{DynamicResource L.Apply}" Click="Apply_Click" Tag="{Binding}" Padding="16,5"
                                            IsEnabled="{Binding CanApply}"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <Button DockPanel.Dock="Right" Content="⋯" Click="More_Click" Tag="{Binding}" Padding="10,5" ToolTip="{DynamicResource L.MoreOptions}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource L.Recapture}" Click="Recapture_Click" />
                                                <MenuItem Header="{DynamicResource L.Duplicate}" Click="Duplicate_Click" />
                                                <MenuItem Header="{DynamicResource L.MoveLeft}" Click="MoveLeft_Click" />
                                                <MenuItem Header="{DynamicResource L.MoveRight}" Click="MoveRight_Click" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource L.Delete}" Click="Delete_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource L.Edit}" Click="Edit_Click" Tag="{Binding}" Padding="12,5" Margin="0,0,6,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ecrãs -->
            <DockPanel Margin="0,20,0,12">
                <Button DockPanel.Dock="Right" Content="{DynamicResource L.IdentifyScreens}" Click="Identify_Click" Padding="14,6" />
                <Button x:Name="EnableAllButton" DockPanel.Dock="Right" Content="{DynamicResource L.TurnAllOn}" Click="EnableAll_Click"
                        Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock Text="{DynamicResource L.ScreensTitle}" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <ItemsControl x:Name="MonitorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:MonitorRow}">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                            <DockPanel>
                                <Border x:Name="Badge" Width="30" Height="30" CornerRadius="15" Margin="0,0,14,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock x:Name="BadgeText" Text="{Binding Number}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.Rename}" Click="Rename_Click" Tag="{Binding}"
                                        Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.TurnOn}" Click="TurnOn_Click" Tag="{Binding}"
                                        Padding="14,4" MinWidth="84" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding OffVisibility}" IsEnabled="{Binding CanToggle}"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.TurnOff}" Click="TurnOff_Click" Tag="{Binding}"
                                        Padding="14,4" MinWidth="84" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding OnVisibility}" IsEnabled="{Binding CanTurnOff}"
                                        ToolTip="{DynamicResource L.TurnOffTip}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" VerticalAlignment="Center"
                                           Style="{StaticResource Muted}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Opções -->
            <WrapPanel Margin="0,18,0,0">
                <CheckBox x:Name="StartupCheck" Content="{DynamicResource L.StartWithWindows}" Margin="0,0,28,0"
                          Checked="Startup_Changed" Unchecked="Startup_Changed" />
                <CheckBox x:Name="NotifyCheck" Content="{DynamicResource L.NotifyOnSwitch}" Margin="0,0,28,0"
                          Checked="Notify_Changed" Unchecked="Notify_Changed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Language}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="LanguageBox" MinWidth="130" SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Português" Tag="pt" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"><Run Text="{DynamicResource L.HintBefore}" /><Run FontWeight="SemiBold" Text="Win + P" /><Run Text="{DynamicResource L.HintAfter}" /></TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
