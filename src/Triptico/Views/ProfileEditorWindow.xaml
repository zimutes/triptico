<Window x:Class="Triptico.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Triptico.Views"
        Title="Perfil"
        Width="580" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="26,20,26,22">
        <TextBlock Text="Nome" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Margin="0,6,0,0" />

        <TextBlock Text="Ecrãs" FontWeight="SemiBold" Margin="0,20,0,0" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8"
                   Text="Marque os que ficam ligados e escolha o principal (onde ficam a barra de tarefas e as janelas novas)." />

        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type v:EditorRow}">
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <RadioButton DockPanel.Dock="Right" GroupName="PrimaryGroup" Content="Principal"
                                         IsChecked="{Binding Primary, Mode=TwoWay}" IsEnabled="{Binding Enabled}"
                                         VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="0" />
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="96" CornerRadius="6" Padding="10" Margin="0,6,0,0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <v:LayoutPreview x:Name="Preview" />
        </Border>

        <TextBlock Text="Atalho de teclado" FontWeight="SemiBold" Margin="0,20,0,0" />
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Limpar" Click="ClearHotkey_Click" Margin="8,0,0,0" Padding="12,5" />
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                     GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" />
        </DockPanel>
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />

        <DockPanel Margin="0,24,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" MinWidth="96" />
                <Button Content="Guardar" IsDefault="True" Click="Save_Click" MinWidth="96" Margin="8,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
            <Button Content="Usar disposição atual" Click="UseCurrent_Click" HorizontalAlignment="Left" Padding="12,5"
                    ToolTip="Copia para este perfil os ecrãs que estão ligados agora e as posições que tem no Windows." />
        </DockPanel>
    </StackPanel>
</Window>
